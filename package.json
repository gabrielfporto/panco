{
  "name": "panco",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "dev": "pnpm --filter @panco/web dev",
    "build": "pnpm --filter @panco/web build",
    "mobile": "pnpm --filter @panco/mobile start",
    "typecheck": "tsc --noEmit && pnpm --filter @panco/mobile typecheck",
    "test": "tsx --test tests/*.test.ts",
    "test:sql": "tsx tests/database.ts",
    "preview": "node scripts/preview.mjs"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "tsx": "4.23.15",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@electric-sql/pglite": "0.5.8"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.117.2",
    "react": "19.2.3"
  }
}
